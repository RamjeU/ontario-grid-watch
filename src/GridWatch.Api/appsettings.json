{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "GridWatch": "Data Source=gridwatch.db"
  },
  "Ingestion": {
    "Enabled": true,
    "SeedSampleData": true,
    "BaseUrl": "https://reports-public.ieso.ca/public/",
    "PollMinutes": 5,
    "DemandEveryMinutes": 15,
    "FuelOutputEveryMinutes": 60,
    "BackfillDays": 45,
    "RealtimeBackfillHours": 48
  },
  "Admin": {
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
